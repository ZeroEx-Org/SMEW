# --- Jupyter ---
.ipynb_checkpoints/
**/.ipynb_checkpoints/

dist/
smew.egg-info/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo

# --- Temporary files ---
*.tmp
*.temp
*.swp
*.bak
*~

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log

# –– doc files –––
docs/

# --- images --- avoid committing large images
*.png
*.jpg
*.jpeg

# -- dev and test folder --
# tests/ is tracked; its scratch files are listed in tests/.gitignore
tests/s0_out/

# --- project case studies ---
# Committed: scripts, notebooks, data sheets. Never committed: field data and
# model outputs. Each project keeps them in these two folders.
Projects/*/Field_data/
Projects/*/runs/
*.pkl
*.npz
!tests/golden/**/*.npz
# Excel lock files
~$*

# --- Claude Code ---
.claude/worktrees/
.claude/settings.local.json

# MOMBAK plotting / field-vs-model comparison scripts: local only
Projects/MOMBAK/*.py
